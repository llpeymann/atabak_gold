# ---------------------------------------------------------------------------
# talaye-atabak — environment template
# Copy to `.env` and fill in the real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Required -----------------------------------------------------------------
# Absolute http(s) URL of the market price API.
PRICE_API_URL=https://api.example.com/market/prices

# Bale bot token and the destination channel id.
BALE_BOT_TOKEN=
BALE_CHANNEL_ID=

# --- Optional: mirror the same messages into a Telegram channel ---------------
# Telegram delivery is enabled only when BOTH values are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Optional: runtime --------------------------------------------------------
# HTTP port the application listens on.
PORT=3000

# --- Optional: price API behaviour -------------------------------------------
# Request timeout in milliseconds (must prevent indefinite waits).
PRICE_API_TIMEOUT_MS=20000
# Maximum attempts per fetch (1 disables retries).
PRICE_API_MAX_ATTEMPTS=3
# Base delay between retries in milliseconds (exponential backoff: delay × 2^(n-1)).
PRICE_API_RETRY_DELAY_MS=1500

# --- Optional: delivery -------------------------------------------------------
# Timeout for each message delivery call in milliseconds.
DELIVERY_TIMEOUT_MS=20000

# --- Optional: currency units -------------------------------------------------
# Unit in which the price API expresses its values (RIAL | TOMAN).
PRICE_API_UNIT=RIAL
# Unit used when rendering messages (RIAL | TOMAN).
PRICE_DISPLAY_UNIT=RIAL
# Per-symbol overrides for APIs that mix units, e.g. "USDT_IRT=TOMAN,USD=TOMAN".
PRICE_SYMBOL_UNITS=

# --- Optional: market validation pipeline (Phase 1) ---------------------------
# Default maximum accepted price change (percent) when a symbol has no specific
# tolerance. Every symbol ships with an explicit, documented threshold in
# `src/market/symbols.ts`; this value is only the fallback.
PRICE_MAX_CHANGE_PERCENT=8
# Comma-separated per-symbol overrides of the change tolerance, e.g.
# "IR_GOLD_18K=12,IR_COIN_EMAMI=15". Must be >= 0; invalid entries abort startup.
PRICE_THRESHOLD_OVERRIDES=
# Multiplier applied to the tolerance when the comparison baseline is the last
# valid price of a previous Tehran day (overnight gaps are naturally larger).
PRICE_CROSS_DAY_CHANGE_MULTIPLIER=2
# A price older than this many minutes is reported as STALE (never published as FRESH).
PRICE_STALE_AFTER_MINUTES=45
# Persistence file for the market state (survives restarts). Empty string disables
# persistence (in-memory only).
MARKET_STATE_FILE=./data/market-state.json
# Admin chat id that receives anomaly alerts (rejections). Empty = log only.
ANOMALY_ALERT_CHAT_ID=
# Minimum minutes between two identical anomaly alerts (per symbol + reason).
ANOMALY_ALERT_COOLDOWN_MINUTES=30

# --- Optional: bot user experience (Phase 2) ---------------------------------
# Persistence file for bot users and their favourites (survives restarts).
# Empty string disables persistence (favourites are then lost on restart).
USER_DATA_FILE=./data/users.json
# Maximum number of favourites a single user may keep (1..100).
MAX_FAVORITES=10
# Channel handle shown in the bot (must start with @).
CHANNEL_HANDLE=@tala_atabak
# Channel/bot deep link used by the "📢 کانال اتابک" button (absolute http(s) URL).
CHANNEL_URL=https://ble.ir/tala_atabak
# Enables inbound update polling (user interaction). Set to false to run the bot as a
# publish-only service; the scheduled channel publications keep working either way.
BOT_POLLING_ENABLED=true
# Long-poll wait (seconds) handed to the platform.
BOT_POLL_TIMEOUT_SECONDS=25
# Delay before retrying after a failed poll (milliseconds).
BOT_POLL_RETRY_DELAY_MS=3000

# --- Optional: price alerts (Phase 3) -----------------------------------------
# Persistence file for alerts and their delivery records (survives restarts).
# Empty string disables persistence (alerts are then lost on restart).
ALERTS_DATA_FILE=./data/alerts.json
# Maximum number of alerts a single user may hold (1..100). ACTIVE + DISABLED count
# towards this limit; TRIGGERED and DELETED alerts do not.
MAX_ALERTS_PER_USER=5
# Extra delivery attempts after the first notification failure
# (total attempts = 1 + this value; 0 disables retries). Allowed: 0..10.
ALERT_NOTIFICATION_MAX_RETRIES=3
# Delay between two notification attempts in milliseconds (0 = immediately). 0..600000.
ALERT_NOTIFICATION_RETRY_DELAY_MS=5000
# Accepted magnitude range of a percentage alert (min .. max, inclusive). 0 < min <= max.
ALERT_MIN_TARGET_PERCENT=0.01
ALERT_MAX_TARGET_PERCENT=100
# How long a half-finished alert wizard waits for the user's numeric answer (minutes).
ALERT_WIZARD_TTL_MINUTES=15

# --- Optional: channel engine (Phase 5) ---------------------------------------
# Persistence file for editorial content, publication jobs and per-destination delivery
# records (survives restarts). Empty string disables persistence: publication history is
# then lost on restart, which weakens duplicate prevention — keep it set in production.
CHANNEL_DATA_FILE=./data/channel.json
# Platform user ids allowed to manage editorial content, comma separated.
# Format: "<userId>" (any platform) or "<bale|telegram>:<userId>" (recommended).
# EMPTY = the whole management surface is disabled (default).
CHANNEL_ADMIN_USER_IDS=
# Longest editorial body an admin may submit (characters; registry limits apply on top).
CHANNEL_MAX_CONTENT_CHARS=3000
# Longest text that may be attached to a photo (platform caption limit).
CHANNEL_MEDIA_CAPTION_LIMIT=1000
# Maximum number of publication jobs kept in the history document.
CHANNEL_HISTORY_LIMIT=500
# Total delivery attempts per destination (1 = no retry; 2..10 = bounded retries).
CHANNEL_PUBLICATION_MAX_ATTEMPTS=3
# Base delay between two delivery attempts (milliseconds, exponential backoff).
CHANNEL_PUBLICATION_RETRY_DELAY_MS=5000
# A scheduled publication older than this grace (minutes) is skipped, never published late.
CHANNEL_MISSED_JOB_GRACE_MINUTES=30
# MARKET_MOVEMENT: default threshold in percent. 0 DISABLES movement publication entirely.
# A missing/zero threshold never means "publish everything".
CHANNEL_MOVEMENT_THRESHOLD_PERCENT=1
# Per-symbol overrides: SYMBOL=PERCENT pairs, comma separated (e.g. IR_GOLD_18K=2,USD=1.5).
# A symbol mapped to 0 never publishes a movement.
CHANNEL_MOVEMENT_THRESHOLD_OVERRIDES=
# Minimum minutes between two movement publications for the same symbol (cooldown).
CHANNEL_MOVEMENT_COOLDOWN_MINUTES=120
# Scheduled DAILY_RANGE message (daily high/low). false = disabled.
CHANNEL_DAILY_RANGE_ENABLED=false
# Time of the daily range message, HH:MM in Asia/Tehran.
CHANNEL_DAILY_RANGE_TIME=21:00
# Event-driven high/low messages when a new daily extreme is established.
CHANNEL_DAILY_RANGE_EVENTS_ENABLED=false
# Minimum minutes between two range events of the same symbol.
CHANNEL_DAILY_RANGE_COOLDOWN_MINUTES=90
# Scheduled DAILY_REPORT message. false = disabled.
CHANNEL_DAILY_REPORT_ENABLED=false
# Time of the daily report, HH:MM in Asia/Tehran.
CHANNEL_DAILY_REPORT_TIME=23:00

# --- Optional: channel <-> bot integration (Phase 6) --------------------------
# Public username of the Bale bot (no @). Used to build channel CTAs and deep links:
#   https://ble.ir/<username>?start=<payload>
# Empty = no Bale CTA/deep link is built (the channel post is published without a button).
BALE_BOT_USERNAME=
# Public username of the Telegram bot (no @). Same contract on the Telegram host:
#   https://t.me/<username>?start=<payload>
# Empty = no Telegram CTA/deep link is built. Configure per platform: the two are never mixed.
TELEGRAM_BOT_USERNAME=
# Public link of the Telegram channel (absolute http(s) URL). The Bale channel is `CHANNEL_URL`;
# a Bale address is not a Telegram destination, so the two are separate keys.
# Empty = the Telegram channel entry is omitted instead of being guessed.
TELEGRAM_CHANNEL_URL=
# Master switch for the call-to-action buttons on channel publications.
# false = every publication is sent without a button (no other behaviour changes).
CHANNEL_CTA_ENABLED=true
# Per-message-type CTA overrides: TYPE=route pairs, comma separated.
# TYPE  ∈ PRICE_UPDATE | MARKET_MOVEMENT | DAILY_RANGE | DAILY_REPORT | EDUCATIONAL |
#         BRANDED | NIGHTLY_ANALYSIS
# route ∈ none | alert | prices | coin | gold | channel
# Example (disable the button on routine price updates, send educational posts to the channel):
#   CHANNEL_CTA_ROUTES=PRICE_UPDATE=none,EDUCATIONAL=channel
# Empty = the registry defaults apply (price/market types → prices·gold·coin by subject group,
# DAILY_REPORT/NIGHTLY_ANALYSIS → prices, EDUCATIONAL/BRANDED → no button).
# An explicit per-content choice (`/content cta <id> <choice>`) always wins.
CHANNEL_CTA_ROUTES=
# Whether the bot screens invite the user to the channel (the four market-report answers).
# false = the invitation line and its button are omitted everywhere.
BOT_CHANNEL_INVITE_ENABLED=true

# --- Phase 7: growth engine (referrals & rewards) ------------------------------------------
# Master switch of the referral system. false = no new registration through a referral link, no
# attribution and no reward is recorded. Everything that already exists (users, codes, referrals,
# rewards and granted capacity) is preserved untouched and stays visible in the referral screen.
REFERRAL_ENABLED=true
# Reward issuance switch, independent of REFERRAL_ENABLED: with this false, successful referrals keep
# being recorded and the ledger catches up (issuing every earned threshold) once it is true again.
REFERRAL_REWARDS_ENABLED=true
# Successful referrals required per reward threshold. The documented product rule is 3.
#   thresholds: 3 → 1, 6 → 2, 9 → 3, 12 → 4 … (unchanged defaults, validated at startup)
REFERRAL_REWARDS_PER_THRESHOLD=3
# Permanent alert slots added per earned threshold. The documented product rule is 1.
REFERRAL_REWARD_BONUS_SLOTS=1
# Rolling window (days) of the "active referred member" statistic. Reporting only — it never gates a
# reward and never revokes one.
REFERRAL_ACTIVE_WINDOW_DAYS=30
# Upper bound on the total bonus slots of one user: the safety valve that makes "unlimited capacity"
# impossible, whatever the two values above are set to.
REFERRAL_MAX_BONUS_SLOTS=50
# Bot destinations used to build referral links (https://ble.ir/<user>?start=ref_<code> and
# https://t.me/<user>?start=ref_<code>). Empty = the referral screen explains that no link is
# configured yet and shows no button; no address is ever guessed.
# Keep these in sync with BALE_BOT_USERNAME / TELEGRAM_BOT_USERNAME unless the product really wants a
# different bot for referrals.
BALE_REFERRAL_BOT_USERNAME=
TELEGRAM_REFERRAL_BOT_USERNAME=
